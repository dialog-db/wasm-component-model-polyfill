// Zena's compiler as a component. This entry module calls the compiler's
// own library code the way Zena's `compileFile` does, with the same
// options as `zena build --target component`, so a compile here returns
// the bytes `zena build` writes for the same source.
//
// Unlike `compileFile`, it keeps a compiler from one compile to the next,
// as Zena's language service does, so the standard library is parsed and
// checked once rather than for every compile: see `Session`. The
// component runtime memory module, whose source is fixed, compiles once
// too.
//
// It reads no file system. The entry module and the declared world come
// in as arguments. Every other file the compile reads, the standard
// library and relative imports included, comes from the host's
// `read-source`. A directory of WIT, such as the standard library's
// `wit`, is read the same way: the host answers its path with the text
// Zena's `readWitSource` makes of it, every `.wit` file in the
// directory in name order, each followed by a newline. A package
// manifest, `zena-packages.json`, comes from the host too, when it has
// one, as `zena build` reads it from the working directory.
import { Future } from 'zena:async';
import { ByteBuffer, Option, Outcome, Ok, Err, Some, StringBuilder, some, none } from 'zena:core';
import { readSource } from 'wcmp:zena-compiler/host';
import { CompilerHost } from 'zena-compiler:library-loader';
import { PackageConfig, stdlibIdToRelativeFile } from 'zena-compiler:module-resolver';
import { loadPackageMap } from 'zena-compiler:package-manifest';
import {
  Compiler, createCompiler, CompilerOptions, checkCompilation, ProgramCheckResult,
  withBuiltinPackages
} from 'zena-compiler:compiler';
import { DiagnosticSeverity, SourceSpan, SyntaxError } from 'zena-compiler:diagnostics';
import { BinaryGenerator } from 'zena-compiler:codegen/binary-generator';
import { Program, CompilationUnit } from 'zena-compiler:program';
import { Module } from 'zena-compiler:ast';
import { compileComponentRuntimeModule } from 'zena-compiler:codegen/component-runtime';
import { makeImportEncoder } from 'zena-compiler:codegen/wit-imports';
import {
  isWitModulePath, synthesizeWitModuleFrom, synthesizeExportWrapper,
  declaredPackageNamespaces
} from 'zena-compiler:wit-module-synth';
import { ComponentEntryWrapper } from 'zena-compiler:component-entry';
import { LanguageService } from 'language-service:service';
import { DocumentHost, FileReader } from 'language-service:host';
import { HoverResult } from 'language-service:hover';
import { format as formatSource } from 'zena-formatter:printer';
import {
  Diagnostic as EditorDiagnostic, HoverInfo as EditorHover, Completion as EditorCompletion,
  Location as EditorLocation, Severity
} from 'wcmp:zena-compiler/language';

/** Where the standard library's `zena/` directory is, as the host names it. */
let stdlibRoot = '/stdlib';

/** The path the declared world's document is read from. */
let worldPath = '/world.wit';

/**
 * The package manifest, read as `zena build` reads it from the working
 * directory: a compile with no manifest has only the standard library
 * and relative imports.
 */
let manifestPath = 'zena-packages.json';

/** The target every compile emits for. */
let target = 'component';

/** A file the host does not have. */
final class MissingSource extends Error {
  new(path: String) : super('Cannot read ' + path + ': the host has no such file');
}

/**
 * The text of `path`: the declared world's document from memory, and
 * everything else from the host.
 */
let readText = (path: String, worldSource: String): String => {
  if (path == worldPath) {
    return worldSource;
  }
  let text = readSource(path);
  if (text is Some<String>) {
    return (text as Some<String>).value;
  }
  throw new MissingSource(path);
};

/**
 * The host the compiler reads source through, as Zena's `FileHost` does
 * for `zena build`: the entry module from memory, `zena:` modules from
 * the standard library, WIT-backed modules synthesized from their WIT,
 * and every other file from the host.
 */
final class HostReader implements CompilerHost {
  var entryPath: String;
  var entrySource: String;
  worldSource: String;
  var packagesWit = '';
  new(this.entryPath, this.entrySource, this.worldSource);

  readFile(path: String): String {
    if (isWitModulePath(path)) {
      let worldSource = this.worldSource;
      return synthesizeWitModuleFrom(path,
          (witRoot: String): String => readText(witRoot, worldSource),
          this.packagesWit);
    }
    if (path == this.entryPath) {
      return this.entrySource;
    }
    if (path.startsWith('zena:')) {
      return readText(stdlibRoot + '/' + stdlibIdToRelativeFile(path), this.worldSource);
    }
    return readText(path, this.worldSource);
  }
}

/** Whether `x` sorts before `y`, byte by byte, as `compileFile` sorts. */
let byteLess = (x: String, y: String): boolean => {
  var minLen = x.length;
  if (y.length < minLen) { minLen = y.length; }
  for (var i = 0; i < minLen; i += 1) {
    let d = x.getByteAt(i) - y.getByteAt(i);
    if (d != 0) { return d < 0; }
  }
  return x.length < y.length;
};

/**
 * The source of every WIT-backed package, the standard library's
 * included, in name order: what `compileFile` hands the encoder so it
 * emits each interface's true types.
 */
let packagesWitOf = (packages: Map<String, PackageConfig>, worldSource: String): String => {
  let allPackages = withBuiltinPackages(stdlibRoot, packages);
  let witPackages = new GrowableArray<String>();
  for (let packageName in allPackages.keys()) {
    let root = allPackages[packageName].witRoot;
    if (root != null && (root as String) != worldPath) {
      witPackages.push(packageName);
    }
  }
  for (var a = 0; a < witPackages.length; a += 1) {
    for (var b = a + 1; b < witPackages.length; b += 1) {
      if (byteLess(witPackages[b], witPackages[a])) {
        let t = witPackages[a];
        witPackages[a] = witPackages[b];
        witPackages[b] = t;
      }
    }
  }
  var text = '';
  for (let packageName in witPackages) {
    text = text + readText(allPackages[packageName].witRoot as String, worldSource) + '\n';
  }
  return text;
};

/**
 * A compiler kept from one compile to the next, as Zena's language
 * service keeps one: the standard library is parsed and checked once,
 * not once for every compile.
 *
 * A session serves one configuration: one package manifest and one
 * declared world, or none. The options and the modules synthesized
 * from WIT then stay the same from one compile to the next, and only
 * the program changes: the entry module and the files it imports.
 *
 * Only the standard library and the modules synthesized from WIT carry
 * from one compile to the next, and neither imports a file of the
 * program. Every file of the program is parsed and checked again for
 * each compile, even one whose text did not change. A check that
 * carried over would still name what the file imported from the last
 * compile, and the code generator follows those names: a module whose
 * import changed under it would compile against the old one.
 */
final class Session {
  host: HostReader;
  compiler: Compiler;
  packages: Map<String, PackageConfig>;
  packagesWit: String;
  /** The check of the last compile, whose standard library carries over. */
  var previous: ProgramCheckResult | null = null;
  /** Every file of the last compile that is the program's. */
  var paths = new GrowableArray<String>();
  new(this.host, this.compiler, this.packages, this.packagesWit);
}

/** The session of each configuration, by `sessionKey`. */
let sessions = new Map<String, Session>();

/**
 * The runtime memory module of each package manifest. Its source is the
 * standard library's, and its compile is deterministic, so one compile
 * serves every component.
 */
let runtimeModules = new Map<String, ByteBuffer>();

/** The key of the configuration a compile runs in. */
let sessionKey = (manifest: String, witSource: String, worldName: String): String => {
  return worldName + '\n' + manifest + '\n' + witSource;
};

/**
 * `kept`, taken out of `sessions` for the length of a compile of
 * `source`, the module at `entryPath`: its compiler forgets every file
 * of the last compile's program, which the compile then reads again.
 */
let resumeSession = (kept: Session, key: String, source: String,
    entryPath: String): Session => {
  sessions.delete(key);
  kept.host.entryPath = entryPath;
  kept.host.entrySource = source;
  for (let path in kept.paths) {
    kept.compiler.delete(path);
  }
  return kept;
};

/** A new session for the configuration a compile runs in. */
/**
 * The packages of a configuration, the WIT text of those backed by WIT,
 * and the options a compiler of it takes.
 */
final class Configuration {
  packages: Map<String, PackageConfig>;
  packagesWit: String;
  options: CompilerOptions;
  new(this.packages, this.packagesWit, this.options);
}

/**
 * The configuration of a compile against the world `worldName` of the
 * WIT document `witSource`, or the derived world when it is empty, with
 * the package manifest when there is one. `host` reads the manifest, and
 * learns the WIT text of the packages.
 */
let configure = (host: HostReader, witSource: String, worldName: String,
    hasManifest: boolean): Configuration => {
  let packages = if (hasManifest) {
    loadPackageMap(host, manifestPath)
  } else {
    new Map<String, PackageConfig>()
  };
  let declared = witSource != '';
  // The declared world's document answers for its own packages, as it
  // does for `zena build --wit`; `wasi` stays the standard library's.
  if (declared) {
    for (let namespace in declaredPackageNamespaces(witSource)) {
      if (namespace == 'wasi' || packages.has(namespace)) { continue; }
      let config = new PackageConfig('', null);
      config.witRoot = worldPath;
      packages[namespace] = config;
    }
  }
  let options = new CompilerOptions(target, stdlibRoot, packages);
  let packagesWit = packagesWitOf(packages, witSource);
  host.packagesWit = packagesWit;
  if (declared) {
    options.componentWrapperSynth =
        (path: String, ast: Module): ComponentEntryWrapper | null =>
            synthesizeExportWrapper(witSource, worldName, path, ast, packagesWit);
  }
  return new Configuration(packages, packagesWit, options);
};

let openSession = (source: String, entryPath: String, witSource: String,
    worldName: String, hasManifest: boolean): Session => {
  let host = new HostReader(entryPath, source, witSource);
  let config = configure(host, witSource, worldName, hasManifest);
  return new Session(host, createCompiler(host, config.options), config.packages,
      config.packagesWit);
};

/**
 * Compile `source`, the module at `entryPath`, against the world
 * `worldName` of the WIT document `witSource`, or against the world
 * Zena derives from the program when `witSource` is empty, as `zena
 * build` does without `--wit`, and answer the bytes of
 * the component or the text of every error, one per line, each naming
 * its file, line, and column.
 *
 * The compile runs in the session of its configuration, which forgets
 * the last compile's program first, so only the standard library and the
 * modules synthesized from WIT carry over. A compile that throws takes
 * its session with it, so a compiler it left half done is never used
 * again.
 */
let compileOnce = (source: String, entryPath: String, witSource: String,
    worldName: String): Outcome<FixedArray<u8>, String> => {
  let manifest = readSource(manifestPath);
  let hasManifest = manifest is Some<String>;
  let manifestText = if (hasManifest) { (manifest as Some<String>).value } else { '' };
  let key = sessionKey(manifestText, witSource, worldName);
  let session = if (sessions.has(key)) {
    resumeSession(sessions[key], key, source, entryPath)
  } else {
    openSession(source, entryPath, witSource, worldName, hasManifest)
  };
  let declared = witSource != '';

  let compResult = session.compiler.compile(entryPath);
  let checkResults = checkCompilation(compResult, session.previous, false, false);
  session.previous = checkResults;
  let paths = new GrowableArray<String>();
  for (let file in compResult.files) {
    if (!file.isStdlib && !isWitModulePath(file.path)) {
      paths.push(file.path);
    }
  }
  session.paths = paths;
  sessions[key] = session;

  let errors = new StringBuilder();
  var hasError = false;
  for (let diag in checkResults.diagnostics) {
    if (diag.severity == DiagnosticSeverity.Error) {
      if (diag.location != null) {
        let loc = diag.location as SourceSpan;
        errors.append(loc.file + ':' + i32ToString(loc.line) + ':' +
            i32ToString(loc.column) + ' - Error: ' + diag.message + '\n');
      } else {
        errors.append('Error: ' + diag.message + '\n');
      }
      hasError = true;
    }
  }
  if (hasError) {
    return new Err<FixedArray<u8>, String>(errors.toString());
  }

  let entryAst = compResult.entry.ast;
  let units = new GrowableArray<CompilationUnit>();
  var entryUnit: CompilationUnit | null = null;
  for (let file in compResult.files) {
    let res = checkResults.results[file.path];
    if (res != null) {
      let unit = {ast: file.ast, model: res.model};
      units.push(unit);
      if (file.ast.path == entryAst.path) {
        entryUnit = unit;
      }
    }
  }
  let program = new Program(units, entryUnit);
  let generator = new BinaryGenerator(target, false, false, 1);
  if (!runtimeModules.has(manifestText)) {
    runtimeModules[manifestText] =
        compileComponentRuntimeModule(session.host, stdlibRoot, session.packages);
  }
  generator.runtimeMemoryModule = runtimeModules[manifestText];
  generator.importEncoder = if (declared) {
    makeImportEncoder(witSource, worldName, session.packagesWit)
  } else {
    makeImportEncoder(null, '', session.packagesWit)
  };
  return new Ok<FixedArray<u8>, String>(generator.generate(program).toByteArray());
};

/**
 * The `compile` export: `compileOnce`, with a syntax error or a missing
 * file answered as the error it is, and any other exception answered
 * with its message, so that a fault in the compiler reaches the host as
 * text rather than a trap.
 */
export async function compile(source: String, entryPath: String,
    witSource: String, worldName: String): Future<Outcome<FixedArray<u8>, String>> {
  try {
    return compileOnce(source, entryPath, witSource, worldName);
  } catch (e) {
    if (e is SyntaxError) {
      return new Err<FixedArray<u8>, String>((e as SyntaxError).message + '\n');
    }
    if (e is Error) {
      return new Err<FixedArray<u8>, String>('Error: ' + (e as Error).message + '\n');
    }
    return new Err<FixedArray<u8>, String>('Error: the compiler threw a value that is not an Error\n');
  }
}

// The language service: what Zena's own language service answers an
// editor, for a program as `compile` would compile it. The service is
// Zena's (`language-service:service`), on a compiler of the same
// configuration as a compile's, which recovers from parse errors as an
// editor wants, and reads through the same host: the standard library
// and the package manifest from `read-source`, and the modules a world
// gives from their WIT.

/** A language service, and the configuration it serves. */
final class Analysis {
  key: String;
  service: LanguageService;
  new(this.key, this.service);
}

/**
 * The one language service kept between calls: a check for another
 * configuration replaces it, and every query answers from the last
 * check.
 */
final class AnalysisSlot {
  var current: Analysis | null = null;
  new() {}
}

let analyses = new AnalysisSlot();

/**
 * The language service for the world `worldName` of `witSource`, or the
 * derived world when it is empty: the one kept, when it serves that
 * configuration, and otherwise a new one, which the slot keeps instead.
 */
let analysisFor = (witSource: String, worldName: String): LanguageService => {
  let manifest = readSource(manifestPath);
  let hasManifest = manifest is Some<String>;
  let manifestText = if (hasManifest) { (manifest as Some<String>).value } else { '' };
  let key = sessionKey(manifestText, witSource, worldName);
  let current = analyses.current;
  if (current != null && (current as Analysis).key == key) {
    return (current as Analysis).service;
  }
  let reader = new HostReader('', '', witSource);
  let config = configure(reader, witSource, worldName, hasManifest);
  config.options.recoverFromParseErrors = true;
  let read: FileReader = (path: String): String | null => {
    let text: String | null = try { reader.readFile(path) } catch (e) { null };
    return text;
  };
  let host = new DocumentHost(stdlibRoot, read);
  let service = new LanguageService(host, createCompiler(host, config.options));
  analyses.current = new Analysis(key, service);
  return service;
};

/**
 * `path` as the language service keys a file: from the root. The service
 * prefixes a path without its leading slash when it looks the file up,
 * but checks a file under the path it was loaded at, so the program's
 * files load from the root too: the entry module, the files beside it,
 * and through them the files they import by a relative path.
 */
let rooted = (path: String): String =>
    if (path.startsWith('/') || path.startsWith('zena:')) { path } else { '/' + path };

/** A path of the program as the editor named it: without the root `rooted` added. */
let unrooted = (path: String): String =>
    if (path.startsWith('/') && !path.startsWith(stdlibRoot + '/') && path != worldPath) {
      path.sliceBytes(1, path.length)
    } else {
      path
    };

/** Whether `file` is the standard library's, whose findings an editor leaves out. */
let isStdlibFile = (file: String): boolean =>
    file.startsWith('zena:') || file.startsWith(stdlibRoot + '/');

/** The language service of the last check, if there was one. */
let lastAnalysis = (): LanguageService | null => {
  let current = analyses.current;
  if (current == null) {
    return null;
  }
  return (current as Analysis).service;
};

/**
 * The `check` export: the diagnostics of the program `compile` would
 * compile, with `files` beside the entry module, in every file that is
 * not the standard library's.
 */
export async function check(source: String, entryPath: String,
    files: Array<(String, String)>, witSource: String,
    worldName: String): Future<Array<EditorDiagnostic>> {
  let out = new GrowableArray<EditorDiagnostic>();
  let service = analysisFor(witSource, worldName);
  for (let file in files) {
    let (path, text) = file;
    service.openDocument(rooted(path), text);
  }
  for (let diag in service.check(rooted(entryPath), source)) {
    let severity = if (diag.severity == DiagnosticSeverity.Error) {
      Severity.Error
    } else if (diag.severity == DiagnosticSeverity.Warning) {
      Severity.Warning
    } else {
      Severity.Information
    };
    if (diag.location == null) {
      out.push(new EditorDiagnostic(entryPath, 0 as u32, 0 as u32, 1 as u32, 1 as u32,
          severity, diag.message));
      continue;
    }
    let loc = diag.location as SourceSpan;
    if (isStdlibFile(loc.file)) {
      continue;
    }
    out.push(new EditorDiagnostic(unrooted(loc.file), loc.start as u32, loc.length as u32,
        loc.line as u32, loc.column as u32, severity, diag.message));
  }
  return out;
}

/** The `hover` export: what is at byte `offset` of `path`, in the last check. */
export async function hover(path: String, offset: u32): Future<Option<EditorHover>> {
  let service = lastAnalysis();
  if (service == null) {
    return none;
  }
  let found = (service as LanguageService).getHover(rooted(path), offset as i32);
  if (found == null) {
    return none;
  }
  let result = found as HoverResult;
  return some(new EditorHover(result.label, result.typeStr, result.docComment));
}

/** The `complete` export: the completions at byte `offset` of `path`, in the last check. */
export async function complete(path: String, offset: u32): Future<Array<EditorCompletion>> {
  let out = new GrowableArray<EditorCompletion>();
  let service = lastAnalysis();
  if (service == null) {
    return out;
  }
  for (let item in (service as LanguageService).getCompletions(rooted(path), offset as i32)) {
    out.push(new EditorCompletion(item.label, (item.kind as i32) as u32, item.detail,
        item.docComment));
  }
  return out;
}

/** The `definition` export: where what is at byte `offset` of `path` is declared. */
export async function definition(path: String, offset: u32): Future<Option<EditorLocation>> {
  let service = lastAnalysis();
  if (service == null) {
    return none;
  }
  let found = (service as LanguageService).getDefinition(rooted(path), offset as i32);
  if (found == null) {
    return none;
  }
  let span = found as SourceSpan;
  return some(new EditorLocation(unrooted(span.file), span.start as u32, span.length as u32,
      span.line as u32, span.column as u32));
}

/** The `format` export: `source` as Zena's formatter prints it. */
export async function format(source: String): Future<Outcome<String, String>> {
  try {
    return new Ok<String, String>(formatSource(source));
  } catch (e) {
    if (e is Error) {
      return new Err<String, String>((e as Error).message);
    }
    return new Err<String, String>('the formatter threw a value that is not an Error');
  }
}
