// A small program the compiler component compiles in its check. It
// reads the standard library, prints through `wasi:cli`, and passes a
// string across the boundary, so the compile reads the standard
// library's modules and its WIT directory through `read-source`.
import { console } from 'zena:console';

export let greet = (name: String): String => {
  console.log('greeting ' + name);
  return 'hello, ' + name;
};
