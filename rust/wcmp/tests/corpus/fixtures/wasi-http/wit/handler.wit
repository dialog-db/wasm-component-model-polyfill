package wcmp:wasi-http@0.1.0;

// `wit/deps/` holds the WASI 0.3 packages this world builds against,
// vendored verbatim; the fixtures README records the commit.

world handler {
  /// The interface `wasi:http` released with WASI 0.3: the handler is
  /// an `async func`, its request and response carry their body as a
  /// `stream<u8>`, and their trailers as a
  /// `future<result<option<trailers>, error-code>>`.
  export wasi:http/handler@0.3.0;

  /// The same body-and-trailers machinery in a signature a `.wast`
  /// directive can call: no `wasi:http` type appears in it. Its future
  /// carries a `u32`, the count of bytes written, because the
  /// Component Model traps a copy between two ends one instance holds
  /// when the payload is not a number, and `drain` holds both ends.
  export drain: async func(bytes: list<u8>) -> list<u8>;

  /// Names the `future<u32>` that `drain` resolves beside its stream.
  /// A wit-bindgen guest can create only the future types a function
  /// of its world names. The guest drops the future it is handed.
  export count: func(written: future<u32>);
}
