// Scenario 4: exceptions. `halve` throws on an odd number. One export
// catches the exception inside the program; the other lets it leave
// the component.
let halve = (n: i32): i32 => {
  if (n % 2 != 0) {
    throw new Error('odd number');
  }
  return n >> 1;
};

export let halveOrZero = (n: i32): i32 => {
  try {
    return halve(n);
  } catch (e) {
    return 0;
  }
};

export let halveOrThrow = (n: i32): i32 => {
  return halve(n);
};
