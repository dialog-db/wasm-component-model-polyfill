// The contract between the Rust importer and the Zena exporter of
// scenario 13. `exporter.zena` compiles against the world `exporter`,
// and the Rust partner under `importer/` binds the world `importer`
// with `wit-bindgen`, so the two sides cannot drift apart.
//
// `greet` is synchronous: the build composes the two components into
// one, so no host function stands between them, and a synchronous
// import can call a synchronous export.
package wcmp:rust-compose;

interface greeter {
  greet: func(name: string) -> string;
}

// The world of `exporter.zena`.
world exporter {
  export greeter;
}

// The world of the Rust partner, `importer/`.
world importer {
  import greeter;
  export welcome: func(name: string) -> string;
}
