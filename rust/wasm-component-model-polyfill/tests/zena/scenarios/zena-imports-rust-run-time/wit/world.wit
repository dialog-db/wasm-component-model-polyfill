// The contract between the Zena importer and the Rust exporter of
// scenario 10. `importer.zena` compiles against the world `importer`,
// and the Rust partner under `exporter/` binds the world `exporter`
// with `wit-bindgen`, so the two sides cannot drift apart.
//
// `greet` is `async`: a run-time link gives the importer a host
// function that calls the exporter's instance, and neither Wasmtime nor
// the polyfill lets a host function call into an instance for an
// import that is not `async`.
package wcmp:rust-link;

interface greeter {
  greet: async func(name: string) -> string;
}

// The world of the Rust partner, `exporter/`.
world exporter {
  export greeter;
}

// The world of `importer.zena`, which awaits `greet`, so its own export
// is `async` too.
world importer {
  import greeter;
  export welcome: async func(name: string) -> string;
}
