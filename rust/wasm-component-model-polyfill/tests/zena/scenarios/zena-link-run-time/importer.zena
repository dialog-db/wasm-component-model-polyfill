// Scenario 8, the importer: `welcome` passes its string to the
// exporter's `greet` across the link and passes the answer back.
import { greet } from 'wcmp:zena-link/greeter';
import { Future } from 'zena:async';

export async function welcome(name: String): Future<String> {
  let greeting = await greet(name);
  return greeting + '!';
}
