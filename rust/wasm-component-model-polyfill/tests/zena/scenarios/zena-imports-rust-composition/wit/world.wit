// The contract between the Zena importer and the Rust exporter of
// scenario 12. `importer.zena` compiles against the world `importer`,
// and the Rust partner under `exporter/` binds the world `exporter`
// with `wit-bindgen`, so the two sides cannot drift apart.
//
// `greet` is synchronous: the build composes the two components into
// one, so no host function stands between them, and a synchronous
// import can call a synchronous export.
package wcmp:rust-compose;

interface greeter {
  greet: func(name: string) -> string;
}

// The world of the Rust partner, `exporter/`.
world exporter {
  export greeter;
}

// The world of `importer.zena`.
world importer {
  import greeter;
  export welcome: func(name: string) -> string;
}
