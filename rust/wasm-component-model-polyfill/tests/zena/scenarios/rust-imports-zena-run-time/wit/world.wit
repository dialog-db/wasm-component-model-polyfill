// The contract between the Rust importer and the Zena exporter of
// scenario 11. `exporter.zena` compiles against the world `exporter`,
// and the Rust partner under `importer/` binds the world `importer`
// with `wit-bindgen`, so the two sides cannot drift apart.
//
// `greet` is `async`: a run-time link gives the importer a host
// function that calls the exporter's instance, and neither Wasmtime nor
// the polyfill lets a host function call into an instance for an
// import that is not `async`.
package wcmp:rust-link;

interface greeter {
  greet: async func(name: string) -> string;
}

// The world of `exporter.zena`.
world exporter {
  export greeter;
}

// The world of the Rust partner, `importer/`, which awaits `greet`, so
// its own export is `async` too.
world importer {
  import greeter;
  export welcome: async func(name: string) -> string;
}
