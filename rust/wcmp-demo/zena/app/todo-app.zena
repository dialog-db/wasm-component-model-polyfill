// <todo-app>: the TodoMVC application. It owns the list: it is the one
// element that calls the API, and it passes the todos to its children
// as attributes. A child reports what a person did with a custom event,
// and this element calls a route and renders again with the new list.
// Its `filter` attribute holds the filter, which the page sets from the
// URL hash.
//
// The page shows a spinner inside this element while it compiles the
// elements, and the element keeps showing it, through a slot, until the
// list has loaded. Then the element reveals the list: it lays the list
// out out of sight to learn its height, and then, at once, grows or
// shrinks its frame to that height, fades the spinner out as it rises,
// and fades the list in as it rises into place.
import { Element, View, Event, h, request } from 'authoring:element';
import { JsonObject, JsonArray, JsonValue, stringify } from 'zena:json';

final class Todo {
  id: String;
  title: String;
  completed: boolean;
  new(this.id, this.title, this.completed);
}

let text = (value: JsonValue): String => {
  if (value is String) {
    return value as String;
  }
  return '';
};

let flag = (value: JsonValue): boolean => {
  if (value is Box<boolean>) {
    return (value as Box<boolean>).value;
  }
  return false;
};

let count = (value: JsonValue): i32 => {
  if (value is Box<f64>) {
    return (value as Box<f64>).value as i32;
  }
  return 0;
};

/** The height of the frame while it shows the spinner, in CSS pixels. */
let spinnerHeight = '240px';

/** The duration and the easing of each part of the reveal. */
let reveal = '450ms cubic-bezier(0.2, 0, 0, 1)';

/** A link out of the demo, which opens in a new tab. */
let link = (href: String, label: String): View => {
  return h('a', {'href' => href, 'target' => '_blank', 'rel' => 'noopener'}, [label],
      new Map<String, String>());
};

/** A paragraph of `words`. */
let paragraph = (words: Array<View | String>): View => {
  return h('p', new Map<String, String>(), words, new Map<String, String>());
};

/** The words about the demo: what it shows, and how it is made. */
let about = (): Array<View | String> => {
  let first = new GrowableArray<View | String>();
  first.push('This app demonstrates some of the potential of the ');
  first.push(link('https://component-model.bytecodealliance.org/', 'Wasm Component Model'));
  first.push('. It has not shipped in web browsers, but you can use it today via the ');
  first.push(link('https://github.com/dialog-db/wasm-component-model-polyfill',
      'Wasm Component Model Polyfill'));
  first.push('.');
  let second = new GrowableArray<View | String>();
  second.push('The site consists of a Rust app shell and a Rust service worker, shipped as '
      + 'two Wasm core modules with a ');
  second.push(link('https://wasm-bindgen.github.io/wasm-bindgen/', 'wasm-bindgen'));
  second.push(' JS shim. The shell defines a closed set of custom elements and the service '
      + 'worker a closed set of routes. Each one is implemented in a ');
  second.push(link('https://zena-lang.dev/', 'Zena'));
  second.push(' source file, editable on the page.');
  let third = new GrowableArray<View | String>();
  third.push('The Zena compiler and tooling ship separately as a Wasm Component. Custom '
      + 'elements are compiled from Zena to Wasm at boot, and routes are compiled lazily on '
      + 'first request. Saving an edit hot-swaps the implementation, and every placement of '
      + 'a component shares one instance.');
  let paragraphs = new GrowableArray<View | String>();
  paragraphs.push(paragraph(first));
  paragraphs.push(paragraph(second));
  paragraphs.push(paragraph(third));
  return paragraphs;
};

export class TodoApp extends Element {
  var todos = new GrowableArray<Todo>();
  var active = 0;
  var completed = 0;
  // How far the reveal has gone: 'measuring' while the list waits out of
  // sight for its height, 'revealing' while the frame moves to that
  // height, and 'shown' once the list stands in the frame on its own.
  var phase = 'measuring';
  // The height of the list, in CSS pixels, as the host last reported it.
  var height = '';
  // Whether the words about the demo show, below the list.
  var about = false;

  attributes(): Array<String> {
    return ['filter'];
  }

  styles(): String {
    return `
      :host {
        display: block;
        max-width: 560px;
        margin: 0 auto;
      }
      .frame {
        position: relative;
        transition: height ${reveal};
      }
      .frame[data-phase="measuring"] {
        height: ${spinnerHeight};
      }
      .spinner {
        position: absolute;
        top: 0;
        right: 0;
        left: 0;
        height: ${spinnerHeight};
        transition: opacity ${reveal}, transform ${reveal};
      }
      .frame[data-phase="revealing"] .spinner {
        opacity: 0;
        transform: translateY(-10px);
      }
      .content {
        transition: opacity ${reveal}, transform ${reveal};
      }
      .frame:not([data-phase="shown"]) .content {
        position: absolute;
        top: 0;
        right: 0;
        left: 0;
      }
      .frame[data-phase="measuring"] .content {
        opacity: 0;
        transform: translateY(10px);
        pointer-events: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .frame,
        .spinner,
        .content {
          transition-duration: 1ms;
        }
        .about {
          animation: none;
        }
      }
      .todoapp {
        background: var(--md-sys-color-surface-container-low);
        border-radius: var(--md-sys-shape-corner-extra-large);
        box-shadow: var(--md-sys-elevation-2);
        overflow: hidden;
      }
      h1 {
        margin: 0;
        padding: 28px 24px 8px;
        font: var(--md-sys-typescale-display-small);
        color: var(--md-sys-color-primary);
        letter-spacing: 0;
      }
      .todo-list {
        list-style: none;
        margin: 0;
        padding: 0 8px 8px;
      }
      .info {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 24px 0 0;
        color: var(--md-sys-color-on-surface-variant);
        font: var(--md-sys-typescale-body-medium);
      }
      .about-toggle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 32px;
        padding: 0 14px 0 10px;
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-full);
        background: transparent;
        color: var(--md-sys-color-on-surface-variant);
        font: var(--md-sys-typescale-label-large);
        cursor: pointer;
      }
      .about-toggle:hover,
      .about-toggle[aria-expanded="true"] {
        background: var(--md-sys-color-surface-container-high);
        color: var(--md-sys-color-on-surface);
      }
      .about-toggle .icon {
        display: inline-grid;
        place-items: center;
        width: 18px;
        height: 18px;
        border: 1.5px solid currentColor;
        border-radius: 50%;
        font: 700 11px / 1 var(--md-ref-typeface);
      }
      .about {
        padding: 0 8px;
        animation: about-in ${reveal};
      }
      .about p {
        margin: 0 0 12px;
      }
      .about p:last-child {
        margin: 0;
      }
      .about a {
        color: var(--md-sys-color-primary);
      }
      @keyframes about-in {
        from {
          opacity: 0;
          transform: translateY(-6px);
        }
      }
    `;
  }

  async connected(): Future<void> {
    await this.load();
  }

  async changed(name: String): Future<void> {
    if (name == 'filter') {
      await this.load();
    }
  }

  async load(): Future<void> {
    var filter = this.attribute('filter');
    if (filter == '') {
      filter = 'all';
    }
    let response = await request('GET', '/api/todos?filter=' + filter);
    let body = response.json();
    let todos = new GrowableArray<Todo>();
    if (body is JsonObject) {
      let fields = body as JsonObject;
      let list = fields['todos'];
      if (list is JsonArray) {
        let items = list as JsonArray;
        for (var i = 0; i < items.length; i += 1) {
          let item = items[i];
          if (item is JsonObject) {
            let todo = item as JsonObject;
            todos.push(new Todo(text(todo['id']), text(todo['title']), flag(todo['completed'])));
          }
        }
      }
      let counts = fields['counts'];
      if (counts is JsonObject) {
        this.active = count((counts as JsonObject)['active']);
        this.completed = count((counts as JsonObject)['completed']);
      }
    }
    this.todos = todos;
  }

  render(): View {
    let total = this.active + this.completed;
    let header = h('header', {'class' => 'header'}, [
      h('h1', new Map<String, String>(), ['todos']),
      h('todo-input', {
        'has-todos' => if (total > 0) 'true' else 'false',
        'all-completed' => if (total > 0 && this.active == 0) 'true' else 'false',
      }, new GrowableArray<View | String>(), {
        'todo-add' => 'add',
        'todo-toggle-all' => 'toggleAll',
      }),
    ]);
    let children = new GrowableArray<View | String>();
    children.push(header);
    if (total > 0) {
      let items = new GrowableArray<View | String>();
      for (let todo in this.todos) {
        items.push(h('todo-item', {
          'key' => todo.id,
          'todo-id' => todo.id,
          'title' => todo.title,
          'completed' => if (todo.completed) 'true' else 'false',
        }, new GrowableArray<View | String>(), {
          'todo-toggle' => 'toggle',
          'todo-destroy' => 'destroy',
          'todo-edit' => 'edit',
        }));
      }
      children.push(h('section', {'class' => 'main'}, [
        h('ul', {'class' => 'todo-list'}, items),
      ]));
      var filter = this.attribute('filter');
      if (filter == '') {
        filter = 'all';
      }
      children.push(h('todo-footer', {
        'active' => i32ToString(this.active),
        'completed' => i32ToString(this.completed),
        'filter' => filter,
      }, new GrowableArray<View | String>(), {
        'todo-clear' => 'clear',
      }));
    }
    let list = h('section', {'class' => 'todoapp'}, children);
    let info = this.info();
    if (this.phase == 'shown') {
      return h('div', {'class' => 'frame', 'data-phase' => this.phase}, [
        h('div', {'class' => 'content', 'key' => 'content'}, [list, info],
            new Map<String, String>()),
      ], new Map<String, String>());
    }
    // The spinner is the page's, which the slot shows.
    // Every argument of `h` is given: Zena's code generator fails on a
    // call here that leaves one to its default.
    let slot = h('slot', new Map<String, String>(), new GrowableArray<View | String>(),
        new Map<String, String>());
    let spinner = h('div', {'class' => 'spinner', 'key' => 'spinner'}, [slot],
        new Map<String, String>());
    let content = h('div', {'class' => 'content', 'key' => 'content'}, [list, info], {
      'resize' => 'measured',
      'transitionend' => 'revealed',
    });
    let frame = {'class' => 'frame', 'data-phase' => this.phase};
    if (this.phase == 'revealing') {
      frame['style'] = 'height: ' + this.height + 'px';
    }
    return h('div', frame, [spinner, content], new Map<String, String>());
  }

  /**
   * Below the list: the pill that shows the words about the demo, and the
   * words while it is open. They appear with the list, which they are
   * about.
   */
  info(): View {
    let none = new Map<String, String>();
    let label = new GrowableArray<View | String>();
    label.push(h('span', {'class' => 'icon', 'aria-hidden' => 'true'}, ['i'], none));
    label.push('About this demo');
    let children = new GrowableArray<View | String>();
    children.push(h('button', {
      'type' => 'button',
      'class' => 'about-toggle',
      'aria-expanded' => if (this.about) 'true' else 'false',
      'aria-controls' => 'about',
    }, label, {'click' => 'about'}));
    if (this.about) {
      children.push(h('div', {'id' => 'about', 'class' => 'about'}, about(), none));
    }
    return h('div', {'class' => 'info'}, children, none);
  }

  async on(handler: String, event: Event): Future<void> {
    // The steps of the reveal, which call no route.
    if (handler == 'measured') {
      this.height = event.value;
      if (this.phase == 'measuring') {
        this.phase = 'revealing';
      }
      return;
    }
    if (handler == 'revealed') {
      if (this.phase == 'revealing') {
        this.phase = 'shown';
      }
      return;
    }
    if (handler == 'about') {
      this.about = !this.about;
      return;
    }
    let headers = new Map<String, String>();
    headers['content-type'] = 'application/json';
    if (handler == 'add') {
      let body = new JsonObject();
      body['title'] = event.value;
      await request('POST', '/api/todos', stringify(body), headers);
    } else if (handler == 'toggleAll') {
      let body = new JsonObject();
      body['completed'] = new Box<boolean>(event.value == 'true');
      await request('PATCH', '/api/todos', stringify(body), headers);
    } else if (handler == 'toggle') {
      for (let todo in this.todos) {
        if (todo.id == event.value) {
          let body = new JsonObject();
          body['completed'] = new Box<boolean>(!todo.completed);
          await request('PATCH', '/api/todos/' + todo.id, stringify(body), headers);
        }
      }
    } else if (handler == 'destroy') {
      await request('DELETE', '/api/todos/' + event.value);
    } else if (handler == 'edit') {
      // The detail is the id, a newline, and the new title. An edit to
      // an empty title deletes the todo.
      let parts = event.value.split('\n');
      let id = parts[0];
      let title = event.value.sliceBytes(id.length + 1, event.value.length).trim();
      if (title == '') {
        await request('DELETE', '/api/todos/' + id);
      } else {
        let body = new JsonObject();
        body['title'] = title;
        await request('PATCH', '/api/todos/' + id, stringify(body), headers);
      }
    } else if (handler == 'clear') {
      await request('DELETE', '/api/todos');
    }
    await this.load();
  }
}
